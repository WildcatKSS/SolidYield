# =============================================================================
# .env.example — kopieer naar .env en vul lokale waarden in.
#
# REGELS
# 1. Zet NOOIT echte secrets, productiesleutels of persoonsgegevens in dit
#    bestand of in .env-bestanden die je commit. .env staat in .gitignore.
# 2. Gebruik in CI/CD GitHub Actions Secrets/Variables of een secrets manager
#    (zie docs/security/secrets-management in docs/security/security-principles.md).
# 3. Gebruik uitsluitend synthetische testdata (zie docs/privacy/data-classification.md).
# 4. Elke nieuwe variabele die hier wordt toegevoegd, moet ook in
#    docs/operations/deployment.md worden beschreven.
# =============================================================================

# --- Applicatie ---
APP_NAME=[PRODUCTNAAM]
APP_ENV=development                 # development | test | staging | production
APP_URL=http://localhost:3000
LOG_LEVEL=debug                     # debug | info | warn | error
# Regio/tenant van de deployment — zie [LANDEN/REGIO] in docs/product/product-vision.md
APP_REGION=eu-west-1

# --- Poorten ---
PORT=3000

# --- Database (placeholder: pas aan op [TECH STACK]) ---
DATABASE_URL=postgresql://app:changeme-local-only@localhost:5432/app_dev
DATABASE_SSL=false                  # true in elke niet-lokale omgeving

# --- Cache / queue (optioneel) ---
REDIS_URL=redis://localhost:6379/0

# --- Authenticatie ---
# Waarden hieronder zijn dummy's voor lokale ontwikkeling.
AUTH_ISSUER_URL=http://localhost:8080/realms/local
AUTH_CLIENT_ID=local-dev-client
AUTH_CLIENT_SECRET=local-dev-not-a-real-secret
SESSION_SECRET=local-dev-not-a-real-secret
SESSION_TTL_MINUTES=15
MFA_REQUIRED=true                   # zie docs/security/access-control.md

# --- Encryptie ---
# Sleutelbeheer via KMS/HSM in niet-lokale omgevingen. Nooit sleutels in code.
KMS_KEY_ID=local-dev-dummy-key
ENCRYPTION_AT_REST=true

# --- Externe (financiële) koppelingen — allemaal sandbox/mock ---
PROVIDER_MODE=mock                  # mock | sandbox | live (live nooit lokaal)
PROVIDER_BASE_URL=http://localhost:4010
PROVIDER_API_KEY=sandbox-dummy-key

# --- Rate limiting & limieten ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
TRANSACTION_DAILY_LIMIT=1000        # zie docs/security/security-principles.md

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
AUDIT_LOG_SINK=stdout               # stdout | file | otlp

# --- Feature flags ---
FEATURE_TEST_GROUP_BANNER=true      # markeert testgroepomgevingen duidelijk in de UI

# --- CI-gedrag (zie scripts/ci/common.sh) ---
# TEMPLATE_STRICT=true laat CI falen zodra de stack is ingevuld.
TEMPLATE_STRICT=false
COVERAGE_MIN=70
